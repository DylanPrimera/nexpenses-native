# STAGE=dev uses platform URL; STAGE=prod uses EXPO_PUBLIC_API_URL.
# Include the Nest global prefix /api/v1 (example: http://192.168.1.10:4000/api/v1).
EXPO_PUBLIC_STAGE=dev
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_URL_IOS=
EXPO_PUBLIC_API_URL_ANDROID=
# Public OAuth client IDs (never put the client secret in the app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
